# Google Gemini API key — get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the model used by the AI Assistant. Default: gemini-2.5-flash
# NOTE: Google has scheduled gemini-2.5-flash for retirement on Oct 16, 2026
# (Developer API). Check https://ai.google.dev/gemini-api/docs/models before
# then and update this value — no code change needed.
GEMINI_MODEL=gemini-3.6-flash